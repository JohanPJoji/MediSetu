APP_NAME=MediSetu Backend
ENVIRONMENT=development
API_V1_PREFIX=/api
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://medisetu:CHANGE_ME@localhost:5432/medisetu

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

LLM_PROVIDER=mock
LLM_API_KEY=
STT_PROVIDER=mock
STT_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=
OCR_PROVIDER=local
OCR_API_KEY=

ABHA_BASE_URL=
ABHA_CLIENT_ID=
ABHA_CLIENT_SECRET=
HIS_BASE_URL=
HIS_API_KEY=
# --- Voice / STT ---
STT_PROVIDER=local
WHISPER_MODEL_SIZE=small
WHISPER_MODEL_DIR=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_SIZE_MB=10
ACCEPTED_AUDIO_FORMATS=audio/wav,audio/webm,audio/ogg,audio/mp3,audio/mpeg,audio/mp4,audio/m4a
STT_MIN_CONFIDENCE=0.65

# --- Optional local TTS ---
TTS_PROVIDER=local
TTS_VOICE=en-US

# --- Optional OpenAI-compatible LLM / Omni Router ---
# Leave LLM_PROVIDER and LLM_API_KEY unset to keep the deterministic local AI fallback.
# LLM_PROVIDER=omnirouter
# LLM_API_KEY=
# LLM_BASE_URL=https://api.omnirouter.ru/v1
# LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

